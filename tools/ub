#!/usr/bin/env bash
# Undefined-behavior tooling. What each mode sees, and what it cannot:
#
#   lint     stable shell. The workspace lints: `unsafe_code = deny`,
#            `unsafe_op_in_unsafe_fn = deny`, and the clippy UB set
#            (undocumented_unsafe_blocks, multiple_unsafe_ops_per_block,
#            unnecessary_safety_comment, not_unsafe_ptr_arg_deref, pointer
#            casts, mem_forget) plus pedantic/all/cargo. Always run this.
#   miri     nightly shell. Miri over pure-Rust crates. It CANNOT execute
#            FFI, so crates linking rquickjs or native-tls are excluded; put
#            unsafe logic in a pure-Rust module with tests to get Miri
#            coverage. No tests, no coverage: it only checks what runs.
#            Isolation is disabled because these crates touch the filesystem;
#            that only gates host syscalls, not Miri's Rust-level UB checks.
#   valgrind nightly shell. Runs test binaries under Valgrind's memcheck,
#            including the C QuickJS build. It sees heap misuse and
#            uninitialized reads across the FFI boundary but does NOT model
#            Rust aliasing rules (Miri does), and it is slow.
#
# AddressSanitizer is not wired: `-Zsanitizer=address` makes rustc reject the
# sanitizer-built rquickjs-macro proc-macro artifacts ("can't find crate"),
# and neither `-Ztarget-applies-to-host` nor a separate host config fixed it.
# Valgrind covers the same C-side ground until that is solved.
#
# Miri and Valgrind are not proofs: they falsify. The written `// SAFETY:`
# invariant plus review is what the AGENTS.md exception requires.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# Pure-Rust crates with tests. Extend when unsafe logic moves into a new one.
miri_crates=(logging)
# Default Valgrind: logging plus `renderer::render` (Stylo `unsafe fn` hooks;
# a handful of small renders, not the full QuickJS renderer suite).

usage() {
  echo "usage: tools/ub [lint|miri [crate...]|valgrind [crate...]]" >&2
  exit 2
}

crate_args() {
  local crates=("$@")
  local args=()
  for crate in "${crates[@]}"; do
    args+=(-p "$crate")
  done
  printf '%s\n' "${args[@]}"
}

valgrind_test() {
  nix develop .#ub --command env \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="valgrind --error-exitcode=1 --track-origins=yes" \
    cargo test --target x86_64-unknown-linux-gnu "$@"
}

case "${1:-lint}" in
  lint)
    exec nix develop --command cargo clippy --workspace --all-targets -- -D warnings
    ;;
  miri)
    shift
    crates=("$@")
    if [ ${#crates[@]} -eq 0 ]; then
      crates=("${miri_crates[@]}")
    fi
    mapfile -t args < <(crate_args "${crates[@]}")
    exec nix develop .#ub --command env \
      MIRIFLAGS="-Zmiri-disable-isolation" \
      cargo miri test "${args[@]}"
    ;;
  valgrind)
    shift
    if [ "$#" -eq 0 ]; then
      # Two invocations: a filter after `-p logging -p renderer` would skip
      # logging. Keep the renderer filter so QuickJS tests stay off the default.
      valgrind_test -p logging
      valgrind_test -p renderer render::
      exit 0
    fi
    mapfile -t args < <(crate_args "$@")
    valgrind_test "${args[@]}"
    ;;
  *)
    usage
    ;;
esac
