#!/usr/bin/env bash
# Extract the canonical failure list from a `tools/wpt/run --score` log.
#
# The score summary truncates "needs attention", so compare the full `▶`
# blocks instead: this prints one line per failing result,
# `STATUS PATH :: SUBTEST`, sorted and deduplicated, ready for `diff`/`comm`.
# Top-level results (an ERROR or TIMEOUT with no failing subtests) print as
# `STATUS PATH :: [top-level]`; subtests print their own line.
#
# usage: tools/wpt/failures LOG [LOG...]   (or pipe one log on stdin)
set -euo pipefail

if [[ $# -eq 0 ]]; then
  set -- /dev/stdin
fi

awk '
  # Block header. Two shapes:
  #   "  ▶ STATUS [expected ...] PATH"          a top-level result
  #   "  ▶ Unexpected (subtest )?result in PATH:" a subtest grouping header
  /^  ▶ / {
    header = $0
    sub(/^  ▶ /, "", header)
    if (header ~ /^Unexpected (subtest )?result in /) {
      path = header
      sub(/^Unexpected (subtest )?result in /, "", path)
      top = ""
    } else {
      top = header
      sub(/ .*/, "", top)
      path = header
      if (path ~ /^[A-Z][A-Z_-]* \[expected[^]]*\] /) {
        sub(/^[A-Z][A-Z_-]* \[expected[^]]*\] /, "", path)
      } else {
        sub(/^[A-Z][A-Z_-]* /, "", path)
      }
      print top " " path " :: [top-level]"
    }
    sub(/:$/, "", path)
    next
  }
  # Result line: "  │ STATUS [expected ...] SUBTEST" or "  └ STATUS ...".
  # Continuation lines ("│   → message", "└ url") do not start with a status.
  /^  [│└] [A-Z][A-Z_-]*( |$)/ {
    line = $0
    sub(/^  [│└] +/, "", line)
    status = line
    sub(/ .*/, "", status)
    if (line ~ /^[A-Z][A-Z_-]* \[expected[^]]*\] /) {
      sub(/^[A-Z][A-Z_-]* \[expected[^]]*\] /, "", line)
    } else {
      sub(/^[A-Z][A-Z_-]* /, "", line)
    }
    if (path != "" && line != "") print status " " path " :: " line
    next
  }
' "$@" | sort -u
