#!/usr/bin/env bash
# Run WPT against tinybrowser. The work lives in cli.py (single Python CLI
# with run | score | rerun | overnight | selftest); this shim only finds a
# Python before the venv exists.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  if command -v uv >/dev/null 2>&1; then
    UV_PY="$(uv python find 3.12 2>/dev/null || true)"
    if [[ -n "${UV_PY}" ]]; then
      PATH="$(dirname "${UV_PY}"):${PATH}"
    fi
  fi
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required to run WPT" >&2
  exit 1
fi

exec python3 "$ROOT/tools/wpt/cli.py" run "$@"
