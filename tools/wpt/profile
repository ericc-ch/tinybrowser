#!/usr/bin/env bash
# Rank WPT tests by wall time, or run a slice and print the browser's timeline.
# The work lives in cli.py (`profile` subcommand); see `tools/wpt/rerun`.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  if command -v uv >/dev/null 2>&1; then
    UV_PY="$(uv python find 3.12 2>/dev/null || true)"
    if [[ -n "${UV_PY}" ]]; then
      PATH="$(dirname "${UV_PY}"):${PATH}"
    fi
  fi
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required to profile WPT runs" >&2
  exit 1
fi

exec python3 "$ROOT/tools/wpt/cli.py" profile "$@"
