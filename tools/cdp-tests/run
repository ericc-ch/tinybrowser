#!/usr/bin/env bash
# Run Chromium's inspector-protocol corpus against the debug binary.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "node is required to run the CDP corpus (nix develop)" >&2
  exit 1
fi

cd "$ROOT"
if [[ -z "${TINYBROWSER_BINARY:-}" ]]; then
  cargo build -q --offline 2>/dev/null || cargo build -q
  TINYBROWSER_BINARY="$("$ROOT/tools/binary-path")"
fi
if [[ ! -x "$TINYBROWSER_BINARY" ]]; then
  echo "tinybrowser binary not found at $TINYBROWSER_BINARY" >&2
  exit 1
fi
export TINYBROWSER_BINARY="$(realpath "$TINYBROWSER_BINARY")"
node --test "$ROOT/tools/cdp-tests/runner.test.mjs"
exec node --experimental-vm-modules "$ROOT/tools/cdp-tests/runner.mjs" "$@"
