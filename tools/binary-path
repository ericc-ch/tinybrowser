#!/usr/bin/env bash
# Print the path of a built binary, resolving cargo's target directory so a
# custom `build.target-dir` or CARGO_TARGET_DIR still points at it.
#
# usage: tools/binary-path [--release] [name]   (default: debug tinybrowser)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

PROFILE=debug
if [ "${1:-}" = "--release" ]; then
  PROFILE=release
  shift
fi
NAME="${1:-tinybrowser}"

TARGET_DIR="$(cargo metadata --no-deps --format-version 1 \
  | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')"
if [ -z "$TARGET_DIR" ]; then
  echo "tools/binary-path: could not resolve the cargo target directory" >&2
  exit 1
fi
echo "$TARGET_DIR/$PROFILE/$NAME"
