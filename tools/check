#!/usr/bin/env bash
# Workspace checks: clippy, embedded JS syntax, rustdoc, Python, Valgrind.
#
#   clippy    stable shell. `cargo fmt --all --check`, then workspace lints,
#            then `node --check` on JavaScript
#            `include_str!`'d into the renderer, then the realm-free layer
#            check (dom/ and documents.rs never name Ctx/Value/Persistent/
#            JsNode), then `cargo doc --no-deps --document-private-items`
#            (intra-doc link lints are denied workspace-wide, so a bare or
#            stale path fails here instead of shipping, private items
#            included), then the Astral Python stack on tools/wpt
#            (`ruff check`, `ruff format --check`, `ty check`, all via uvx
#            with versions pinned below). Always run this.
#   valgrind nightly shell. Runs test binaries under Valgrind's memcheck,
#            including the C QuickJS build. It sees heap misuse and
#            uninitialized reads across the FFI boundary but does not model
#            Rust aliasing rules, and it is slow.
#
# With no subcommand, clippy (including embedded JS). AddressSanitizer is not wired:
# `-Zsanitizer=address` makes rustc reject the sanitizer-built rquickjs-macro
# proc-macro artifacts ("can't find crate"), and neither
# `-Ztarget-applies-to-host` nor a separate host config fixed it. Valgrind
# covers the same C-side ground until that is solved.
#
# Valgrind is not a proof: it falsifies. The written `// SAFETY:`
# invariant plus review is what the AGENTS.md exception requires.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

# `tools/check valgrind` with no crate names runs the workspace test suite.
# Named crates are a narrower run.

usage() {
  echo "usage: tools/check [clippy|valgrind [crate...]]" >&2
  exit 2
}

crate_args() {
  local crates=("$@")
  local args=()
  for crate in "${crates[@]}"; do
    args+=(-p "$crate")
  done
  printf '%s\n' "${args[@]}"
}

run_rust() {
  nix develop --command cargo fmt --all --check
  nix develop --command cargo clippy --workspace --all-targets -- -D warnings
}

run_js() {
  if ! command -v node >/dev/null 2>&1; then
    echo "node is required to check the embedded JavaScript (nix develop)" >&2
    exit 1
  fi
  local checked=0 status=0 file output
  while IFS= read -r -d '' file; do
    checked=$((checked + 1))
    if ! output="$(node --check "$file" 2>&1)"; then
      printf '%s\n' "$output" >&2
      status=1
    fi
  done < <(find crates/renderer/src/js -name '*.js' -print0)
  if [[ "$checked" -eq 0 ]]; then
    echo "no embedded JavaScript found under crates/renderer/src/js" >&2
    exit 1
  fi
  echo "js: checked $checked files"
  return "$status"
}

run_layers() {
  # Below `js/` there is no `Ctx`, `Value`, `Persistent`, or `JsNode`, no
  # `rquickjs`, and no reach into `crate::{js,document,engine}`: the DOM
  # layer, the document store, and the encoding sniffer hold tree/algorithm
  # code that the bindings call, never the reverse. Full-line comments may
  # name the rule.
  local pattern='\b(Ctx|Value|Persistent|JsNode)\b|rquickjs|crate::(js|document|engine)\b'
  local matches
  matches="$(grep -rnE "$pattern" crates/renderer/src/dom crates/renderer/src/documents.rs \
    crates/renderer/src/sniff.rs --include='*.rs' \
    | grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|/\*|\*)' || true)"
  if [[ -n "$matches" ]]; then
    printf '%s\n' "$matches" >&2
    echo "layer check: dom/, documents.rs, and sniff.rs must stay realm-free" >&2
    return 1
  fi
  echo "layers: dom/, documents.rs, and sniff.rs are realm-free"
  return 0
}

run_docs() {
  # Workspace `warnings` (deny) covers rustdoc's intra-doc link lints, and
  # `--document-private-items` documents private items too, so a broken or
  # stale path fails the gate instead of shipping.
  nix develop --command cargo doc --workspace --no-deps --document-private-items
}

# Astral pins for the tools/wpt Python stack (ruff = lint + format, ty =
# types). Bump together after `uvx <tool>@<version>` proves green.
RUFF_PIN="ruff@0.14.8"
TY_PIN="ty@0.0.9"

run_py() {
  if ! command -v uvx >/dev/null 2>&1; then
    echo "uvx is required to lint tools/wpt (used for the WPT venv already)" >&2
    exit 1
  fi
  uvx "$RUFF_PIN" check tools/wpt
  uvx "$RUFF_PIN" format --check tools/wpt
  if [[ ! -f third_party/wpt/wpt ]]; then
    # ty resolves upstream modules through extra-paths into the checkout
    # (see tools/wpt/pyproject.toml); without it only ruff can run.
    echo "py: skipping ty, WPT checkout missing (git submodule update --init third_party/wpt)" >&2
    return 0
  fi
  uvx "$TY_PIN" check --project tools/wpt tools/wpt/cli.py tools/wpt/tinybrowser_wpt.py
}

valgrind_test() {
  nix develop .#check --command env \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="valgrind --error-exitcode=1 --track-origins=yes" \
    cargo test --target x86_64-unknown-linux-gnu "$@"
}

case "${1:-clippy}" in
  clippy)
    tools/webidl/import --check
    run_rust
    run_js
    run_layers
    run_docs
    run_py
    ;;
  valgrind)
    shift
    if [ "$#" -eq 0 ]; then
      valgrind_test --workspace
    else
      mapfile -t args < <(crate_args "$@")
      valgrind_test "${args[@]}"
    fi
    ;;
  *)
    usage
    ;;
esac
