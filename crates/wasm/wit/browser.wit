/// The browser component's host contract.
///
/// The component owns pages, cookies, and redirect policy; the host owns the
/// network transport and performs one HTTP exchange per request. Every rule
/// below is a host obligation. A host that cannot honor one must answer with a
/// `fetch-error` rather than guess, because the component trusts these answers
/// for cookie and origin decisions.
package tinybrowser:browser@0.1.0;

interface types {
    enum fetch-kind {
        /// A script's `fetch()` or `XMLHttpRequest`.
        js-fetch,
        /// A classic `<script src>` load.
        classic-script,
    }

    record fetch-request {
        /// Correlates this exchange with its completion. Unique within the
        /// component instance, and reused for nothing else.
        id: u64,
        /// Component-side tab identity. The host uses it to find the tab to
        /// pump, because a page's first request starts while its constructor
        /// runs and the host does not have the tab handle yet.
        owner: u64,
        kind: fetch-kind,
        /// Absolute `http`/`https` URL of this exchange.
        url: string,
        /// Document URL the dial started from.
        initiator: string,
        /// When false, only status and metadata are used.
        read-body: bool,
        /// Hard cap on `fetch-response.body`; a larger body is `limit`.
        max-body-bytes: u64,
        /// Value for the `Cookie` request header of this exchange.
        ///
        /// The component computed it for `url` alone. The host must send it to
        /// `url`'s origin and to no other: a redirect the component chooses to
        /// follow arrives as a new request with its own header, so reusing this
        /// value for another origin would disclose one site's cookies to
        /// another.
        ///
        /// Browsers forbid scripts from setting `Cookie` and from reading
        /// `Set-Cookie`, so a host that runs in a browser can only carry this
        /// value through an intermediary it controls, such as the development
        /// proxy described in the repository notes.
        cookie: string,
    }

    record fetch-response {
        /// HTTP status of this exchange, unreduced. A 3xx status is reported
        /// as such so the component can decide whether to follow it.
        status: u16,
        /// Absolute URL of this exchange's response, when the host knows one
        /// that differs from the request URL. The component falls back to the
        /// request URL, so an empty value is safe.
        final-url: string,
        /// `Content-Type` header, when the transport exposes it.
        content-type: option<string>,
        /// `Content-Language` header, when the transport exposes it.
        content-language: option<string>,
        /// Every `Set-Cookie` line of this exchange, verbatim.
        ///
        /// The component parses and stores them against the request URL. The
        /// host must not filter by `HttpOnly` and must not pre-join lines. Each
        /// exchange reports its own lines, so a redirect hop's cookies are
        /// stored even though the host never reports that hop as a response.
        set-cookies: list<string>,
        /// `Location` header of a redirect status, when the host can see it.
        ///
        /// A host that cannot observe redirects leaves this empty and reports
        /// the final exchange instead; see `start-fetch`.
        location: option<string>,
        /// Response bytes, capped by `fetch-request.max-body-bytes`.
        body: list<u8>,
    }

    enum fetch-error {
        /// Name resolution failed.
        dns,
        /// Connection or proxy failure, including rejection by CORS.
        connect,
        /// TLS handshake or certificate verification failed.
        tls,
        /// A deadline expired.
        timeout,
        /// `max-body-bytes` was exceeded, or a redirect cap was hit.
        limit,
        /// The host is at capacity for this request.
        queue-full,
        /// The component cancelled the request, or the tab went away.
        cancelled,
    }
}

/// Transport the component asks for network work.
interface host {
    use types.{fetch-request};

    /// Performs one HTTP exchange and returns whether it was accepted.
    ///
    /// The exchange must not follow redirects when the host can avoid it: a
    /// 3xx status and its `Location` are reported back, and the component
    /// decides whether to ask for another exchange with a new request. A host
    /// that cannot see redirects, such as a browser `fetch` without an
    /// intermediary, may follow them itself and report the final response; the
    /// component then sees a status it does not follow and uses that response.
    ///
    /// A `true` answer obligates the host to call `engine.complete-fetch`
    /// exactly once for this `id`, unless the component cancels it first. The
    /// call returns before the exchange settles. A `false` answer means the
    /// host cannot serve this request at all, such as a non-HTTP scheme or an
    /// unavailable intermediary; the component fails the dial itself, so the
    /// host must not complete it. Capacity pressure is instead `true` followed
    /// by `complete-fetch` with `queue-full`.
    start-fetch: func(request: fetch-request) -> bool;

    /// Stops work for an unfinished exchange.
    ///
    /// The component completes that request as `cancelled`, so the host must
    /// not call `complete-fetch` for the `id` afterwards.
    cancel-fetch: func(id: u64);
}

/// Page engine the host drives.
interface engine {
    use types.{fetch-error, fetch-response};

    /// What happened in a page.
    ///
    /// Navigation is the host's decision in this component: the host mounts
    /// documents, so the navigation variants a browser process would report
    /// are not produced here. A child frame reaching load arrives as `load`
    /// with that child's frame.
    variant event {
        /// A frame reached `readyState = "complete"` and dispatched `load`.
        load,
        /// A host timer whose delay elapsed.
        timer(u32),
        /// A `fetch` or classic-script job finished with this HTTP status.
        fetch(u16),
        /// `send` or the body read failed.
        fetch-failed,
        /// A timer or `fetch` callback threw.
        script-failed,
    }

    record frame-event {
        /// Frame the event happened in; `0` is the tab's main frame.
        frame: u64,
        event: event,
    }

    /// One page, driven by the host.
    ///
    /// The host owns the pump loop: it calls `pump` after every state change
    /// it causes, then waits for the returned delay before pumping again.
    /// Nothing runs while the host does not pump.
    resource tab {
        /// Mounts `html` as the tab's first document at `url`.
        ///
        /// Fails when `url` is not a valid absolute `http`/`https` URL, in
        /// which case no tab exists and nothing was mounted.
        ///
        /// The mount parses and may start requests before this constructor
        /// returns, so a host must not call any other method of this resource
        /// while a component export is on the stack: pump only after the call
        /// that caused it returns.
        constructor(url: string, html: string) -> result<tab, string>;
        /// This tab's `fetch-request.owner` value.
        owner: func() -> u64;
        /// Evaluates `source` in the main frame and returns its string
        /// coercion. Throws surface as the error side.
        eval: func(source: string) -> result<string, string>;
        /// Runs every ready task, then returns milliseconds until the next
        /// timer, or none when the page has nothing scheduled.
        pump: func() -> option<u64>;
        /// Drains pending events and clears them from the tab.
        events: func() -> result<list<frame-event>, string>;
        /// Text of the document's title.
        title: func() -> result<string, string>;
        /// Text content of the document body; empty before the body exists.
        text: func() -> result<string, string>;
    }

    /// Delivers one exchange's outcome, returning whether it was expected.
    ///
    /// A `false` answer means the request was unknown: already cancelled, or
    /// its tab is gone. The host calls `pump` on the tab reporting this
    /// request's `owner` after a `true` answer.
    complete-fetch: func(id: u64, outcome: result<fetch-response, fetch-error>) -> bool;
}

world browser {
    import host;
    export engine;
}
