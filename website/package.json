{
  "name": "tinybrowser-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "bun run sync-data && astro build",
    "check": "bun run contrast && bun run typecheck && bun run lint && bun run format && bun run build",
    "contrast": "bun scripts/check-contrast.ts",
    "cf:deploy": "alchemy deploy --stage prod",
    "cf:destroy": "alchemy destroy --stage prod",
    "cf:plan": "alchemy plan --stage prod",
    "dev": "astro dev",
    "dev:network": "astro dev --host",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "astro preview",
    "preview:network": "astro preview --host",
    "sync-data": "bun run scripts/sync-data.ts",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.1.0-beta"
  }
}
