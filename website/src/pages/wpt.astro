---
import AreaTable from "@/components/AreaTable.astro"
import HistoryChart from "@/components/HistoryChart.astro"
import Regressions from "@/components/Regressions.astro"
import Base from "@/layouts/Base.astro"
import { loadSnapshot } from "@/lib/data"
import {
  counter,
  formatCount,
  formatDate,
  formatPercent,
  shortSha,
  subtestPercent,
  testPercent,
} from "@/lib/record"

const { latest, index, regressions } = loadSnapshot()

const score = latest ? subtestPercent(latest.totals) : null
const files = latest ? testPercent(latest.totals) : null

// The newest index entry repeats `latest`; the delta is against the one before.
const previousScore = index.length > 1 ? subtestPercent(index[1].totals) : null
const delta = score !== null && previousScore !== null ? score - previousScore : null

const commitHref = latest?.product_revision
  ? `https://github.com/tinybrowser-dev/tinybrowser/commit/${latest.product_revision}`
  : null

const raw = [
  ["latest.json", "the newest full record"],
  ["index.json", "one entry per run"],
  ["regressions.json", "diff against the previous run"],
  ["failures.jsonl.gz", "every failing test and subtest, gzipped JSON lines"],
]
---

<Base
  title="Web Platform Tests — tinybrowser"
  description="tinybrowser's Web Platform Tests score, history, and regressions."
>
  <div class="page-head">
    <div class="measure">
      <h1 class="page-title">Web Platform Tests</h1>
      <p class="lede">
        How much of the pinned WPT corpus tinybrowser passes, by folder and by run. One point per
        code push.
      </p>
    </div>
    {latest && <p class="run-meta">
      Latest run {formatDate(latest.time_end)} ·{" "}
      {commitHref ? (
        <a class="sha" href={commitHref} rel="noreferrer">
          {shortSha(latest.product_revision)}
        </a>
      ) : (
        "—"
      )}{" "}
      · WPT <span class="sha">{shortSha(latest.wpt_revision)}</span>
    </p>}
  </div>

  {latest === null ? (
    <div class="card empty">
      <p>
        No run has been published yet. The first push to <code>main</code> that touches the engine
        writes it.
      </p>
    </div>
  ) : (
    <>
      <div class="stats">
        <div class="card">
          <p class="stat-label">Subtests passing</p>
          <p class="stat-value">{formatPercent(score)}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "subtest_pass"))} of{" "}
            {formatCount(counter(latest.totals, "subtests"))}
            {delta !== null && Math.abs(delta) >= 0.05 && <span class="delta">
              {delta >= 0 ? "+" : ""}
              {delta.toFixed(1)} pts
            </span>}
          </p>
        </div>
        <div class="card">
          <p class="stat-label">Files passing</p>
          <p class="stat-value">{formatPercent(files)}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "pass"))} of{" "}
            {formatCount(counter(latest.totals, "tests"))}
          </p>
        </div>
        <div class="card">
          <p class="stat-label">Skipped</p>
          <p class="stat-value">{formatCount(counter(latest.totals, "skip"))}</p>
          <p class="stat-detail">files the corpus or the lane marks as skipped</p>
        </div>
        <div class="card">
          <p class="stat-label">Unexpected failures</p>
          <p class="stat-value">{formatCount(counter(latest.totals, "unexpected"))}</p>
          <p class="stat-detail">
            {formatCount(counter(latest.totals, "timeout"))} timeouts ·{" "}
            {formatCount(counter(latest.totals, "error"))} errors ·{" "}
            {formatCount(counter(latest.totals, "crash"))} crashes
          </p>
        </div>
      </div>

      <div class="section">
        <HistoryChart index={index} />
      </div>

      <div class="section">
        <Regressions regression={regressions} />
      </div>

      <div class="section">
        <AreaTable areas={latest.areas} />
      </div>

      <div class="section card">
        <h2>Raw data</h2>
        <p class="lede">
          These are the files the page reads. No API key, no shape promise beyond what the page
          consumes.
        </p>
        <ul class="raw-list">
          {raw.map(([name, description]) => <li>
            <a href={`/wpt/data/${name}`}>/wpt/data/{name}</a>
            <span class="muted"> — {description}</span>
          </li>)}
        </ul>
      </div>
    </>
  )}
</Base>
