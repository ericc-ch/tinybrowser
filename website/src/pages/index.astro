---
import Base from "@/layouts/Base.astro"
import { loadSnapshot } from "@/lib/data"
import { formatPercent, subtestPercent } from "@/lib/record"

const { latest } = loadSnapshot()
const score = latest ? subtestPercent(latest.totals) : null
---

<Base title="tinybrowser" description="A small, fast, spec-first headless browser for AI agents.">
  <section class="home measure">
    <h1>tinybrowser</h1>
    <p class="lede">
      A small, fast, spec-first headless browser for AI agents. Conformance is the product, so the
      Web Platform Tests run on every code push and the result is published in the open.
    </p>
    <p class="links">
      <a href="/wpt">Conformance dashboard</a>
      <a href="https://github.com/tinybrowser-dev/tinybrowser" rel="noreferrer">Source</a>
      <a href="/wpt/data/latest.json">Raw record</a>
    </p>
    {latest && <p class="lede">
      Latest run: {formatPercent(score)} of subtests passing across{" "}
      {latest.totals.tests.toLocaleString("en-US")} files.
    </p>}
  </section>
</Base>
