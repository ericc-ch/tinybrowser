---
import "@fontsource-variable/plus-jakarta-sans/wght.css"
import "@fontsource-variable/jetbrains-mono/wght.css"
import sans from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2"
import "@/styles/main.css"

interface Props {
  title: string
  description?: string
}

const { title, description = "A small, fast, spec-first headless browser for AI agents." } =
  Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <script is:inline>
      ;(() => {
        const root = document.documentElement
        root.dataset.js = "1"

        let stored = null
        try {
          stored = localStorage.getItem("theme")
        } catch {
          stored = null
        }

        if (stored === "light" || stored === "dark") root.dataset.theme = stored
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="wrap site-nav" aria-label="Main">
        <a href="/">tinybrowser</a>
        <a href="/wpt">WPT</a>
        <a href="https://github.com/tinybrowser-dev/tinybrowser" rel="noreferrer">GitHub</a>
        <button id="theme-toggle" type="button">theme</button>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>MIT licensed</span>
        <a href="/wpt/data/latest.json">raw data</a>
        <a href="https://github.com/tinybrowser-dev/tinybrowser-wpt-results" rel="noreferrer">
          history repo
        </a>
      </div>
    </footer>

    <script is:inline>
      ;(() => {
        const root = document.documentElement
        const button = document.getElementById("theme-toggle")
        const query = window.matchMedia("(prefers-color-scheme: dark)")
        const current = () => root.dataset.theme ?? (query.matches ? "dark" : "light")

        const render = () => {
          if (!button) return
          const dark = current() === "dark"
          button.textContent = dark ? "Light" : "Dark"
          button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme")
        }

        render()

        button?.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark"
          root.dataset.theme = next
          try {
            localStorage.setItem("theme", next)
          } catch {
            /* storage is optional */
          }
          render()
        })

        query.addEventListener("change", () => {
          if (!root.dataset.theme) render()
        })
      })()
    </script>
  </body>
</html>
