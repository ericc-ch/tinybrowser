---
import { plural, type Regression } from "@/lib/record"

interface Props {
  regression: Regression | null
  /** Change in passing subtests against the previous index entry. */
  passDelta: number | null
}

const { regression, passDelta } = Astro.props

/** A flaky file puts every subtest in the diff; the count is the files, not the rows. */
function fileCount(rows: Array<{ test: string }>): number {
  return new Set(rows.map((row) => row.test)).size
}

const regressed = regression ? fileCount(regression.regressions) : 0
const fixed = regression ? fileCount(regression.fixes) : 0
const timedOut = regression ? fileCount(regression.new_timeouts) : 0
const comparable = regression !== null && regression.previous_sha !== null && regression.comparable
---

<div class="card">
  <div class="section-head">
    <h2>What changed</h2>
    {comparable && <span class="note">one run against the previous one</span>}
  </div>
  {regression === null ? (
    <p class="diff-note">No diff published yet.</p>
  ) : regression.previous_sha === null ? (
    <p class="diff-note">
      First published run: there is nothing to compare with yet. The next run gets a diff.
    </p>
  ) : !regression.comparable ? (
    <p class="diff-note">
      The WPT revision changed, so this run is not comparable with the previous one.
    </p>
  ) : (
    <div>
      {passDelta !== null && <p class="diff-lead">
        <span class="strong">
          {(passDelta >= 0 ? "+" : "−") + Math.abs(passDelta).toLocaleString("en-US")}
        </span
        >{" "} subtests passing since the previous run
      </p>}
      <p class="diff-counts">
        <span class={regressed ? "strong" : "muted"}>{plural(regressed, "file")} regressed</span>
        <span class="muted">{plural(fixed, "file")} fixed</span>
        <span class="muted">{plural(timedOut, "file")} newly timing out</span>
      </p>
      <p class="diff-note">
        A test that flips with runner load lands here too.{" "}
        <a href="/wpt/data/regressions.json">The raw diff</a> has every file and subtest.
      </p>
    </div>
  )}
</div>
