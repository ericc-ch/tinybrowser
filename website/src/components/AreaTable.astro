---
import OutcomeBar from "@/components/OutcomeBar.astro"
import { counter, formatCount, formatPercent, subtestPercent, type Counters } from "@/lib/record"

interface Props {
  areas: Record<string, Counters>
}

const { areas } = Astro.props

const rows = Object.entries(areas)
  .map(([name, counters]) => ({
    name,
    counters,
    percent: subtestPercent(counters),
    subtests: counter(counters, "subtests"),
  }))
  .sort((a, b) => b.subtests - a.subtests)
---

<div class="card table-card">
  <div class="section-head">
    <h2>By folder</h2>
    <input
      id="area-filter"
      class="filter"
      type="search"
      placeholder="filter folders"
      aria-label="Filter folders"
    />
  </div>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Folder</th>
          <th class="num">Subtests passing</th>
          <th>Outcomes</th>
          <th class="num">Files passing</th>
          <th class="num">Unexpected</th>
        </tr>
      </thead>
      <tbody id="area-rows">
        {rows.map((row) => <tr data-area={row.name}>
          <td>
            <a href={`https://wpt.fyi/results/${row.name}`} rel="noreferrer">
              {row.name}
            </a>
          </td>
          <td class="num">{formatPercent(row.percent)}</td>
          <td>
            <div class="bar-cell">
              <OutcomeBar counters={row.counters} compact />
            </div>
          </td>
          <td class="num muted">{formatCount(counter(row.counters, "pass"))}</td>
          <td class="num">
            {counter(row.counters, "unexpected") > 0 ? (
              <span class="strong">{formatCount(counter(row.counters, "unexpected"))}</span>
            ) : (
              <span class="muted">0</span>
            )}
          </td>
        </tr>)}
      </tbody>
    </table>
  </div>
</div>

<script>
  const filter = document.getElementById("area-filter") as HTMLInputElement | null
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#area-rows tr"))
  filter?.addEventListener("input", () => {
    const needle = filter.value.trim().toLowerCase()
    for (const row of rows) {
      const name = row.dataset.area?.toLowerCase() ?? ""
      row.hidden = needle !== "" && !name.includes(needle)
    }
  })
</script>
