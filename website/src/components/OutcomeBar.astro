---
import { counter, type Counters } from "@/lib/record"

interface Props {
  counters: Counters
  compact?: boolean
}

const { counters, compact = false } = Astro.props
const subtests = counter(counters, "subtests")
const total = Math.max(subtests, 1)

// Monochrome, by ink intensity: the more ink a segment carries, the worse the
// outcome. Pass is faint, a timeout mid, a failure strongest; skips and any
// status this list does not name fall back to the surface itself.
const parts = [
  { label: "pass", count: counter(counters, "subtest_pass"), className: "bar-pass" },
  {
    label: "timeout",
    count: counter(counters, "subtest_timeout") + counter(counters, "subtest_notrun"),
    className: "bar-timeout",
  },
  {
    label: "fail",
    count: counter(counters, "subtest_fail") + counter(counters, "subtest_error"),
    className: "bar-fail",
  },
].filter((part) => part.count > 0)

const known = parts.reduce((sum, part) => sum + part.count, 0)
const other = subtests - known
if (other > 0) {
  parts.push({ label: "skip", count: other, className: "bar-rest" })
}
---

<div
  class:list={["bar", compact && "bar-compact"]}
  role="img"
  aria-label={parts.map((part) => `${part.count} ${part.label}`).join(", ")}
>
  {parts.map((part) => (
    <span
      class={part.className}
      style={`width:${(part.count / total) * 100}%`}
      title={`${part.label}: ${part.count.toLocaleString("en-US")}`}
    />
  ))}
</div>
